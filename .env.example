# ---- Runtime ----
NODE_ENV=development            # development | test | production
PORT=3000
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
CORS_ORIGINS=http://localhost:5173,http://localhost:3001   # comma separated; "*" is rejected in production

# ---- Database ----
DATABASE_PATH=./data/trialguard.db

# ---- Auth (REQUIRED, no defaults) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ---- OTP ----
# Secret used to HMAC OTPs before storage (REQUIRED, must differ from JWT_SECRET)
OTP_PEPPER=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Seconds before another OTP can be issued/resent for the same visit.
OTP_RESEND_COOLDOWN_SECONDS=60
# Per-user request limits per 15 minutes (on top of the cooldown, hourly cap and attempt lockout).
OTP_ISSUE_RATE_LIMIT_MAX=30
OTP_VERIFY_RATE_LIMIT_MAX=60
# Development convenience: return the OTP in the issue response and expose
# GET /api/v1/dev/visits/:id/otp. The app REFUSES TO START if this is true in production,
# and if it is combined with OTP_EMAIL_ENABLED=true.
DEMO_OTP_ENABLED=true

# ---- OTP email delivery (Resend, https://resend.com) ----
# true  -> OTPs are emailed to the participant's linked portal account (requires the two values below).
#          Set DEMO_OTP_ENABLED=false when you turn this on.
# false -> no email is sent. With DEMO_OTP_ENABLED=false too, issuing an OTP returns 503 (it never exposes the code).
OTP_EMAIL_ENABLED=false
RESEND_API_KEY=                 # secret: from the Resend dashboard (API Keys). Never commit it.
OTP_FROM_EMAIL=                 # e.g. "TrialVerse <noreply@yourdomain.com>"; the domain must be verified in Resend
OTP_EMAIL_TIMEOUT_MS=10000

# ---- Rate limiting ----
AUTH_RATE_LIMIT_MAX=30          # requests per 15 min per IP on /auth/login and /auth/register
RATE_LIMIT_ENABLED=true

# ---- ML integration (Phase 0 ships interfaces only; disabled by default) ----
ML_RISK_ENABLED=false
ML_RISK_URL=                    # e.g. http://localhost:8001
ML_INTEGRITY_ENABLED=false
ML_INTEGRITY_URL=               # e.g. http://localhost:8002
ML_TIMEOUT_MS=3000
ML_API_KEY=                     # optional bearer token sent to the model service

# ---- Rule overrides (optional JSON, merged over defaults) ----
RISK_RULES_OVERRIDES=
INTEGRITY_RULES_OVERRIDES=
